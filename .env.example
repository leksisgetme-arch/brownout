# ---------------------------------------------------------------------------
# Brownout environment
# Copy to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# Pooled connection string (hostname contains "-pooler"). Used at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/brownout?sslmode=require"

# Direct (non-pooled) connection string. Used only by Drizzle migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/brownout?sslmode=require"

# Test-only endpoints (POST /api/test/*). Leave "false" in production.
TEST_MODE="false"

# Required when TEST_MODE=true. Minimum 16 characters. Sent as the
# "x-brownout-test-secret" header by the test suite. Never expose to the browser.
TEST_SECRET="change-me-to-a-long-random-value"

# Requires at least 16 characters. Sent as `Authorization: Bearer <secret>` by the
# per-minute drill clock: Vercel Cron (vercel.json) or the Netlify scheduled
# function (netlify/functions/cron-tick.ts). Without it /api/cron/tick answers 404.
CRON_SECRET="change-me-to-another-long-random-value"
